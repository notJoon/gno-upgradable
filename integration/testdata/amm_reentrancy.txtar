# A real node must reject implementation activation from a swap callback.

patchpkg 'const UpgradeDelay = 17280' 'const UpgradeDelay = 2'
loadpkg gno.land/p/nt/bptree/v0
loadpkg gno.land/p/nt/cford32/v0
loadpkg gno.land/p/nt/grc20/v0
loadpkg gno.land/p/nt/seqid/v0
loadpkg gno.land/p/upgrade/v0 $WORK/src/p/upgrade/v0
loadpkg gno.land/r/upgrade/testtoken $WORK/src/r/upgrade/testtoken
loadpkg gno.land/r/upgrade/amm $WORK/src/r/upgrade/amm
loadpkg gno.land/r/upgrade/amm/v1 $WORK/src/r/upgrade/amm/v1

gnoland start

gnokey maketx call -pkgpath gno.land/r/upgrade/amm -func Approve -args gno.land/r/upgrade/amm/v1 -gas-fee 1000000ugnot -gas-wanted 50000000 -broadcast -chainid=tendermint_test test1
stdout OK!
gnokey maketx call -pkgpath gno.land/r/upgrade/amm/v1 -func Bootstrap -gas-fee 1000000ugnot -gas-wanted 50000000 -broadcast -chainid=tendermint_test test1
stdout OK!
gnokey maketx addpkg -pkgdir $WORK/v2 -pkgpath gno.land/r/upgrade/amm/v2 -gas-fee 1000000ugnot -gas-wanted 50000000 -broadcast -chainid=tendermint_test test1
stdout OK!
gnokey maketx call -pkgpath gno.land/r/upgrade/amm/v2 -func Setup -gas-fee 1000000ugnot -gas-wanted 50000000 -broadcast -chainid=tendermint_test test1
stdout OK!

gnokey maketx call -pkgpath gno.land/r/upgrade/amm -func Approve -args gno.land/r/upgrade/amm/v2 -gas-fee 1000000ugnot -gas-wanted 50000000 -broadcast -chainid=tendermint_test test1
stdout OK!
gnokey maketx call -pkgpath gno.land/r/upgrade/amm/v2 -func Prepare -gas-fee 1000000ugnot -gas-wanted 50000000 -broadcast -chainid=tendermint_test test1
stdout OK!

gnokey maketx send -send 1ugnot -to $test1_user_addr -gas-fee 1000000ugnot -gas-wanted 50000000 -broadcast -chainid=tendermint_test test1
stdout OK!
gnokey maketx send -send 1ugnot -to $test1_user_addr -gas-fee 1000000ugnot -gas-wanted 50000000 -broadcast -chainid=tendermint_test test1
stdout OK!
! gnokey maketx call -pkgpath gno.land/r/upgrade/amm/v2 -func Attack -gas-fee 1000000ugnot -gas-wanted 50000000 -broadcast -chainid=tendermint_test test1
stderr 'upgrade: reentrant call'
gnokey query vm/qeval --data 'gno.land/r/upgrade/amm.ImplPath()'
stdout '"gno.land/r/upgrade/amm/v1"'

-- v2/gnomod.toml --
module = "gno.land/r/upgrade/amm/v2"
gno = "0.9"

-- v2/amm.gno --
package amm

import (
	"chain"

	"gno.land/p/upgrade/v0"
	proxy "gno.land/r/upgrade/amm"
	v1 "gno.land/r/upgrade/amm/v1"
	"gno.land/r/upgrade/testtoken"
)

type impl struct{ v1.Impl }

func (impl) ID() string { return "gno.land/r/upgrade/amm/v2:impl" }

func Setup(cur realm) {
	pool := chain.PackageAddress("gno.land/r/upgrade/amm")
	testtoken.Faucet(cross(cur), 2000)
	must(testtoken.A.RealmTeller(0, cur).Approve(0, cur, pool, 1000))
	must(testtoken.B.RealmTeller(0, cur).Approve(0, cur, pool, 1000))
	proxy.Call(cross(cur), "AddLiquidity", "1000 1000")
}

func Prepare(cur realm) {
	proxy.Prepare(cross(cur), impl{})
}

func Attack(cur realm) {
	self := chain.PackageAddress("gno.land/r/upgrade/amm/v2")
	activate := func(cur realm, _ int64, _ *proxy.CallbackMarker) {
		proxy.Register(cross(cur))
	}
	proxy.Swap(cross(cur), true, 100, 1, self, activate)
}

func must(err error) {
	if err != nil {
		panic(err.Error())
	}
}

var _ upgrade.Impl = impl{}
